---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import SponsorTier from '~/components/widgets/SponsorTier.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { gold, silver, bronze, inKind } from '~/data/sponsors';
import { TEAM_EMAIL } from '~/data/contact';

const metadata = {
  title: 'Sponsors',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Thank you"
    title="Our Sponsors"
    subtitle="The ViPrs are made possible by the schools, companies, and families who support us. Their generosity funds our robot, our competitions, and our outreach."
  />

  <SponsorTier title="Gold" subtitle="$5,000 and above" sponsors={gold} size="lg" accent="#D4A017" />
  <SponsorTier title="Silver" subtitle="$1,000 – $4,999" sponsors={silver} size="md" accent="#A8A9AD" isAfterContent />
  <SponsorTier title="Bronze" subtitle="Under $1,000" sponsors={bronze} size="sm" accent="#B0703A" isAfterContent />
  <SponsorTier title="In-Kind" sponsors={inKind} size="md" accent="#3B82F6" isAfterContent />

  <CallToAction
    id="become-a-sponsor"
    actions={[
      {
        variant: 'primary',
        text: 'Contact Us',
        href: `mailto:${TEAM_EMAIL}?subject=Sponsoring%20The%20ViPrs`,
      },
    ]}
  >
    <Fragment slot="title">Become a sponsor</Fragment>
    <Fragment slot="subtitle">
      Sponsoring The ViPrs helps students build real engineering and business skills. We'd love to talk about how you
      can get involved.
    </Fragment>
  </CallToAction>
</Layout>
