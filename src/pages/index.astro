---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';

const metadata = {
  title: 'Team 1329 - The ViPrs | FIRST Robotics Competition',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="FIRST Robotics Competition · Team 1329"
    actions={[
      { variant: 'primary', text: 'Meet the Team', href: '/team' },
      { text: 'Join the ViPrs', href: '/signup' },
    ]}
    image={{
      src: '~/assets/images/team/Team-Photo.JPG',
      alt: 'The ViPrs team group photo',
      width: 1536,
      height: 1024,
    }}
  >
    <Fragment slot="title">
      We are <span class="text-accent dark:text-white">The ViPrs</span>
    </Fragment>

    <Fragment slot="subtitle">
      A student-run robotics team from St. Louis, Missouri, building robots, skills, and a small business along the way.
    </Fragment>
  </Hero>

  <!-- Introduction ****************** -->

  <Features
    id="about"
    columns={3}
    tagline="Who we are"
    title="Introducing The ViPrs"
    subtitle="The ViPrs are a FIRST Robotics Competition team based in St. Louis, Missouri. Our team is student-run by 7th–12th graders from Priory and Visitation Academy. As a business-oriented team, we strive not only to excel in competition, but to teach students about engineering, technology, and creativity."
    items={[
      {
        title: 'Student-run',
        description:
          'Students in grades 7–12 from Priory and Visitation Academy lead the team, from design and build to strategy.',
        icon: 'tabler:users-group',
      },
      {
        title: 'Run like a business',
        description:
          'We operate as a small business, and every student takes part in fundraising, marketing, and planning.',
        icon: 'tabler:briefcase',
      },
      {
        title: 'More than competition',
        description:
          'We compete to win, but our real goal is teaching engineering, technology, and creativity to every member.',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <!-- Mission *********************** -->

  <WidgetWrapper id="mission" containerClass="max-w-4xl">
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
    <Headline tagline="What drives us" title="Our Mission" classes={{ container: 'mb-6 md:mb-8' }} />
    <blockquote
      class="text-lg md:text-xl leading-relaxed text-center text-muted dark:text-slate-300 border-l-4 border-primary pl-6 text-left md:text-center md:border-l-0 md:pl-0"
    >
      “Our mission is to cultivate interest, understanding, and skill in the fields of science, technology, engineering,
      art, and business. We seek to encourage the creativity of thought, perseverance in the face of obstacles, and
      cooperation and compromise as individuals who are part of a team. We seek to develop life skills in students
      through team membership, critical thinking, and unique experiences. We operate as a small business and encourage
      full participation of all students in every aspect of the team.”
    </blockquote>
  </WidgetWrapper>

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      { variant: 'primary', text: 'Sign Up', href: '/signup' },
      { text: 'Become a Sponsor', href: '/sponsors' },
    ]}
  >
    <Fragment slot="title">Get involved</Fragment>

    <Fragment slot="subtitle">
      Whether you want to join the team or support us as a sponsor, we'd love to hear from you.
    </Fragment>
  </CallToAction>
</Layout>
