---
import { getImage } from 'astro:assets';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Image from '~/components/common/Image.astro';
import type { Robot } from '~/data/robots';

export interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
  tagline?: string;
  robots: Robot[];
}

const { id, title, subtitle, tagline, robots } = Astro.props;

// Larger, uncropped version of each photo for the popup.
const items = await Promise.all(
  robots.map(async (robot) => ({
    ...robot,
    alt: robot.name ? `${robot.name}, the ${robot.year} ViPrs robot` : `The ${robot.year} ViPrs robot`,
    full: (await getImage({ src: robot.image, width: Math.min(robot.image.width, 1600) })).src,
  }))
);
---

<WidgetWrapper id={id} containerClass="max-w-6xl">
  <Fragment slot="bg"><slot name="bg" /></Fragment>
  <Headline title={title} subtitle={subtitle} tagline={tagline} classes={{ title: 'text-2xl md:text-3xl' }} />
  <ul class="grid gap-6 md:gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {
      items.map(({ year, name, game, image, alt, full }) => {
        const heading = name ?? game ?? `${year} Robot`;
        const caption = [year, name, game].filter(Boolean).join(' · ');
        return (
          <li>
            <button
              type="button"
              class="robot-card group flex flex-col w-full h-full overflow-hidden rounded-lg bg-white dark:bg-slate-900 shadow-sm ring-1 ring-gray-200 dark:ring-slate-800 text-center cursor-zoom-in transition hover:shadow-md focus-visible:outline-2 focus-visible:outline-primary"
              data-full={full}
              data-alt={alt}
              data-caption={caption}
              aria-label={`View larger photo of ${heading} (${year})`}
            >
              <div class="aspect-[4/3] w-full overflow-hidden bg-gray-100 dark:bg-slate-800">
                <Image
                  src={image}
                  alt={alt}
                  layout="responsive"
                  width={800}
                  height={600}
                  widths={[400, 800]}
                  sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 352px"
                  class="w-full h-full transition-transform duration-300 group-hover:scale-105"
                />
              </div>
              <div class="p-4 w-full">
                <p class="text-primary dark:text-link font-bold text-sm tracking-wide">{year}</p>
                <p class="font-bold text-heading text-xl leading-tight">{heading}</p>
                {name && game && <p class="text-muted text-sm">{game}</p>}
              </div>
            </button>
          </li>
        );
      })
    }
  </ul>

  <dialog
    id="robot-lightbox"
    class="m-auto max-w-[95vw] max-h-[95vh] bg-transparent p-0 backdrop:bg-black/80 backdrop:backdrop-blur-sm"
    aria-label="Robot photo"
  >
    <figure class="relative flex flex-col items-center">
      <button
        type="button"
        data-close
        class="absolute -top-2 -right-2 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white text-2xl leading-none text-gray-900 shadow-lg hover:bg-gray-200"
        aria-label="Close"
      >
        &times;
      </button>
      <img class="block max-w-[95vw] max-h-[85vh] w-auto h-auto rounded-lg object-contain" src="" alt="" />
      <figcaption class="mt-3 text-center text-white font-semibold"></figcaption>
    </figure>
  </dialog>
</WidgetWrapper>

<script>
  const setupRobotLightbox = () => {
    const dialog = document.getElementById('robot-lightbox') as HTMLDialogElement | null;
    if (!dialog) return;
    const img = dialog.querySelector('img')!;
    const caption = dialog.querySelector('figcaption')!;

    document.querySelectorAll<HTMLButtonElement>('.robot-card').forEach((card) => {
      card.addEventListener('click', () => {
        img.src = card.dataset.full ?? '';
        img.alt = card.dataset.alt ?? '';
        caption.textContent = card.dataset.caption ?? '';
        dialog.showModal();
      });
    });

    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    // Close when clicking the dark backdrop around the photo.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  };

  document.addEventListener('astro:page-load', setupRobotLightbox);
</script>
