---
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Image from '~/components/common/Image.astro';
import type { TeamMember } from '~/data/team';

export interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
  tagline?: string;
  members: TeamMember[];
  isAfterContent?: boolean;
}

const { id, title, subtitle, tagline, members, isAfterContent = false } = Astro.props;

// Shown when a role has no photo yet (e.g. an open position).
const fallbackImage = '~/assets/images/brand/ViPrs-Logo.png';
---

<WidgetWrapper id={id} containerClass={`max-w-6xl ${isAfterContent ? 'pt-0 md:pt-0 lg:pt-0' : ''}`}>
  <Fragment slot="bg"><slot name="bg" /></Fragment>
  <Headline title={title} subtitle={subtitle} tagline={tagline} classes={{ title: 'text-2xl md:text-3xl' }} />
  <ul class="flex flex-wrap justify-center gap-6 md:gap-8">
    {
      members.map(({ name, role, detail, image }) => (
        <li class="w-[calc(50%-0.75rem)] sm:w-48 md:w-52 text-center">
          <div class="aspect-square overflow-hidden rounded-lg bg-gray-100 dark:bg-slate-800 shadow-sm">
            <Image
              src={image ?? fallbackImage}
              alt={name ? `${name}, ${role}` : ''}
              layout="responsive"
              width={400}
              height={400}
              widths={[300, 600]}
              sizes="(max-width: 639px) 50vw, 208px"
              class:list={['w-full h-full', { 'opacity-40': !name }]}
            />
          </div>
          <p class="mt-3 font-bold text-heading text-lg leading-tight">
            {name ?? <span class="text-muted italic font-medium">Position open</span>}
          </p>
          <p class="text-primary dark:text-blue-200 font-semibold text-sm">{role}</p>
          {detail && <p class="text-muted text-sm">{detail}</p>}
        </li>
      ))
    }
  </ul>
</WidgetWrapper>
