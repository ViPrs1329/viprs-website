---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Button from '~/components/ui/Button.astro';
import { TEAM_EMAIL, WEB3FORMS_ACCESS_KEY } from '~/data/contact';

export interface Props {
  id?: string;
}

const { id } = Astro.props;

const inputClass =
  'py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900';
const labelClass = 'block text-sm font-medium mb-1';
const optionClass =
  'flex items-start gap-3 cursor-pointer rounded-lg border border-gray-200 dark:border-gray-700 p-3 has-[:checked]:border-primary';
const tabClass =
  'flex-1 rounded-md px-4 py-2 font-semibold transition text-muted hover:text-heading aria-selected:bg-primary aria-selected:text-white aria-selected:shadow-sm';

// Student form
const grades = ['6th', '7th', '8th', '9th', '10th', '11th', '12th'];
const interests = [
  { value: 'Robot side', detail: 'Design, fabrication, controls, programming, driving' },
  { value: 'MTR side', detail: 'Marketing, graphic design, outreach, fundraising' },
  { value: 'Not sure yet', detail: "We'll help you find your fit" },
];

// Mentor form
const connections = ['Parent or guardian', 'Priory alum', 'Priory faculty or staff', 'Industry professional', 'Other'];
const expertise = [
  'Mechanical & fabrication',
  'Electrical & controls',
  'Programming',
  'CAD & design',
  'Marketing & media',
  'Outreach',
  'Fundraising & business',
  'General help',
];
---

<WidgetWrapper id={id} containerClass="max-w-2xl">
  <div class="rounded-lg bg-white dark:bg-slate-900 shadow-sm ring-1 ring-gray-200 dark:ring-slate-800 p-6 md:p-10">
    <div role="tablist" aria-label="Sign up as" class="mb-8 flex gap-1 rounded-lg bg-gray-100 dark:bg-slate-800 p-1">
      <button
        type="button"
        role="tab"
        id="tab-student"
        aria-controls="signup-student"
        aria-selected="true"
        class={tabClass}
      >
        Student
      </button>
      <button
        type="button"
        role="tab"
        id="tab-mentor"
        aria-controls="signup-mentor"
        aria-selected="false"
        class={tabClass}
      >
        Mentor
      </button>
    </div>

    <!-- Student sign-up ****************** -->

    <form
      id="signup-student"
      role="tabpanel"
      aria-labelledby="tab-student"
      class="signup-form"
      data-access-key={WEB3FORMS_ACCESS_KEY}
      data-team-email={TEAM_EMAIL}
      novalidate
    >
      <input type="hidden" name="subject" value="New ViPrs student sign-up" />
      <input type="hidden" name="from_name" value="ViPrs Website" />
      <!-- Spam trap: hidden from people, bots fill it in. -->
      <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label for="student-name" class={labelClass}>Name</label>
          <input id="student-name" name="name" type="text" autocomplete="name" required class={inputClass} />
        </div>
        <div>
          <label for="student-grade" class={labelClass}>Grade</label>
          <select id="student-grade" name="grade" required class={inputClass}>
            <option value="" disabled selected>Select your grade</option>
            {grades.map((grade) => <option value={grade}>{grade}</option>)}
          </select>
        </div>
        <div class="sm:col-span-2">
          <label for="student-email" class={labelClass}>Email</label>
          <input id="student-email" name="email" type="email" autocomplete="email" required class={inputClass} />
        </div>
      </div>

      <fieldset class="mt-6">
        <legend class={labelClass}>What are you interested in?</legend>
        <div class="grid gap-3 mt-2">
          {
            interests.map(({ value, detail }) => (
              <label class={optionClass}>
                <input type="checkbox" name="interests" value={value} class="mt-1 cursor-pointer" />
                <span>
                  <span class="block font-semibold">{value}</span>
                  <span class="block text-sm text-muted">{detail}</span>
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="mt-6">
        <label for="student-message" class={labelClass}>
          Anything else? <span class="text-muted font-normal">(optional)</span>
        </label>
        <textarea
          id="student-message"
          name="message"
          rows="4"
          placeholder="Experience, questions, or what you're excited to try"
          class={inputClass}></textarea>
      </div>

      <p data-status role="status" aria-live="polite" class="mt-6 hidden rounded-lg p-3 text-sm font-medium"></p>

      <div class="mt-8 grid">
        <Button variant="primary" type="submit">Sign Up</Button>
      </div>
    </form>

    <!-- Mentor sign-up ******************* -->

    <form
      id="signup-mentor"
      role="tabpanel"
      aria-labelledby="tab-mentor"
      class="signup-form"
      data-access-key={WEB3FORMS_ACCESS_KEY}
      data-team-email={TEAM_EMAIL}
      novalidate
      hidden
    >
      <input type="hidden" name="subject" value="New ViPrs mentor sign-up" />
      <input type="hidden" name="from_name" value="ViPrs Website" />
      <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

      <p class="mb-6 text-muted">
        Mentors share their time and experience with our students. You don't need to be an engineer: we need help with
        everything from programming to fundraising.
      </p>

      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label for="mentor-name" class={labelClass}>Name</label>
          <input id="mentor-name" name="name" type="text" autocomplete="name" required class={inputClass} />
        </div>
        <div>
          <label for="mentor-connection" class={labelClass}>Connection to the team</label>
          <select id="mentor-connection" name="connection" required class={inputClass}>
            <option value="" disabled selected>Select one</option>
            {connections.map((connection) => <option value={connection}>{connection}</option>)}
          </select>
        </div>
        <div>
          <label for="mentor-email" class={labelClass}>Email</label>
          <input id="mentor-email" name="email" type="email" autocomplete="email" required class={inputClass} />
        </div>
        <div>
          <label for="mentor-phone" class={labelClass}>
            Phone <span class="text-muted font-normal">(optional)</span>
          </label>
          <input id="mentor-phone" name="phone" type="tel" autocomplete="tel" class={inputClass} />
        </div>
      </div>

      <fieldset class="mt-6">
        <legend class={labelClass}>Where could you help?</legend>
        <div class="grid gap-3 mt-2 sm:grid-cols-2">
          {
            expertise.map((value) => (
              <label class={optionClass}>
                <input type="checkbox" name="expertise" value={value} class="mt-1 cursor-pointer" />
                <span class="font-semibold">{value}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="mt-6">
        <label for="mentor-message" class={labelClass}>
          Tell us about yourself <span class="text-muted font-normal">(optional)</span>
        </label>
        <textarea
          id="mentor-message"
          name="message"
          rows="4"
          placeholder="Your background, availability, or any questions"
          class={inputClass}></textarea>
      </div>

      <p data-status role="status" aria-live="polite" class="mt-6 hidden rounded-lg p-3 text-sm font-medium"></p>

      <div class="mt-8 grid">
        <Button variant="primary" type="submit">Sign Up to Mentor</Button>
      </div>
    </form>
  </div>
</WidgetWrapper>

<script>
  const statusStyles = {
    success: 'bg-green-100 text-green-900 dark:bg-green-900/40 dark:text-green-100',
    error: 'bg-red-100 text-red-900 dark:bg-red-900/40 dark:text-red-100',
  };

  const setupTabs = () => {
    const tabs = document.querySelectorAll<HTMLButtonElement>('[aria-label="Sign up as"] [role="tab"]');
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((other) => {
        const selected = other === tab;
        other.setAttribute('aria-selected', String(selected));
        document.getElementById(other.getAttribute('aria-controls')!)!.hidden = !selected;
      });
    };
    tabs.forEach((tab) => tab.addEventListener('click', () => select(tab)));

    // Link straight to the mentor form with /signup#mentor.
    const mentorTab = document.getElementById('tab-mentor') as HTMLButtonElement | null;
    if (mentorTab && location.hash === '#mentor') select(mentorTab);
  };

  const setupForm = (form: HTMLFormElement) => {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    const showStatus = (kind: keyof typeof statusStyles, message: string) => {
      status.className = `mt-6 rounded-lg p-3 text-sm font-medium ${statusStyles[kind]}`;
      status.textContent = message;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const accessKey = form.dataset.accessKey;
      if (!accessKey) {
        showStatus('error', `Sign-ups are not set up yet. Please email ${form.dataset.teamEmail} instead.`);
        return;
      }

      const data = new FormData(form);
      const payload: Record<string, unknown> = Object.fromEntries(data);
      // Checkbox groups send one value per box; combine them into a single line.
      form.querySelectorAll<HTMLFieldSetElement>('fieldset').forEach((fieldset) => {
        const name = fieldset.querySelector<HTMLInputElement>('input[type="checkbox"]')?.name;
        if (name) payload[name] = data.getAll(name).join(', ') || 'Not specified';
      });
      payload.access_key = accessKey;
      // Lets the team reply straight to the person who signed up.
      payload.replyto = data.get('email');

      submit.disabled = true;
      const label = submit.textContent;
      submit.textContent = 'Sending…';

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await response.json();
        if (!response.ok || !result.success) throw new Error(result.message);
        form.reset();
        showStatus('success', "Thanks for signing up! We'll be in touch soon.");
      } catch {
        showStatus(
          'error',
          `Something went wrong sending your sign-up. Please try again, or email ${form.dataset.teamEmail}.`
        );
      } finally {
        submit.disabled = false;
        submit.textContent = label;
      }
    });
  };

  document.addEventListener('astro:page-load', () => {
    setupTabs();
    document.querySelectorAll<HTMLFormElement>('.signup-form').forEach(setupForm);
  });
</script>
